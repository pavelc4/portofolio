---
import { Icon } from 'astro-icon/components';

const stackRow1 = [
    { name: "Rust", icon: "skill-icons:rust", tag: "SYSTEM" },
    { name: "C / C++", icon: "skill-icons:cpp", tag: "CORE" },
    { name: "Golang", icon: "skill-icons:golang", tag: "BACKEND" },
    { name: "Docker", icon: "skill-icons:docker", tag: "INFRA" },
    { name: "PostgreSQL", icon: "skill-icons:postgresql-dark", tag: "DATABASE" },
    { name: "MongoDB", icon: "skill-icons:mongodb", tag: "NOSQL" },
    { name: "SQL", icon: "skill-icons:mysql-dark", tag: "DATABASE" },
    { name: "Linux", icon: "skill-icons:linux-dark", tag: "OS" },
    { name: "AWS", icon: "skill-icons:aws-dark", tag: "CLOUD" },
    { name: "Cloudflare", icon: "skill-icons:cloudflare-dark", tag: "CDN" },
    { name: "GitHub", icon: "skill-icons:github-dark", tag: "VCS" },
];

const stackRow2 = [
    { name: "TypeScript", icon: "skill-icons:typescript", tag: "LANG" },
    { name: "Bun", icon: "skill-icons:bun-dark", tag: "RUNTIME" },
    { name: "Elysia.js", icon: "skill-icons:elysia-dark", tag: "FRAMEWORK" },
    { name: "Hono.js", icon: "logos:hono", tag: "EDGE FW" },
    { name: "Svelte", icon: "skill-icons:svelte", tag: "FRONTEND" },
    { name: "Astro", icon: "skill-icons:astro", tag: "SSG" },
    { name: "Kotlin", icon: "skill-icons:kotlin-dark", tag: "MOBILE" },
    { name: "YAML", icon: "devicon:yaml", tag: "CONFIG" },
    { name: "TOML", icon: "logos:toml", tag: "CONFIG" },
];

const row1 = [...stackRow1, ...stackRow1];
const row2 = [...stackRow2, ...stackRow2];
---

<section
    id="skills"
    class="py-16 md:py-24 bg-bocchi-cream border-y-4 border-gray-900 overflow-hidden relative"
>
    <div
        class="max-w-5xl mx-auto text-center px-6 md:px-12 mb-8 md:mb-12 reveal"
    >
        <p
            class="font-jp text-gray-500 font-bold tracking-widest text-xs md:text-sm mb-2 md:mb-4"
        >
            きた いくよ • Arsenal
        </p>
        <h2
            class="font-oswald text-4xl md:text-6xl lg:text-7xl text-red-600 uppercase tracking-tighter"
        >
            Tech Stack.
        </h2>
    </div>

    <div class="w-full overflow-hidden flex whitespace-nowrap mask-edges py-2">
        <div
            class="flex items-center gap-4 md:gap-6 pr-4 md:pr-6 w-max animate-marquee"
            onmouseenter="this.style.animationPlayState='paused'"
            onmouseleave="this.style.animationPlayState='running'"
        >
            {
                row1.map((item) => (
                    <div class="flex-shrink-0 flex items-center gap-2 md:gap-4 bg-white border-2 border-gray-900 px-4 md:px-6 py-2 md:py-3 shadow-brutalist-sm md:shadow-brutalist transition-transform hover:-translate-y-1 cursor-default group">
                        <Icon 
                            name={item.icon} 
                            class="w-5 h-5 md:w-8 md:h-8 grayscale group-hover:grayscale-0 transition-all" 
                        />
                        <span class="font-oswald text-lg md:text-2xl font-bold uppercase tracking-tight text-gray-900">
                            {item.name}
                        </span>
                        <span class="font-mono text-[8px] md:text-[10px] text-bocchi-pink font-bold border-l-2 border-gray-900 pl-2 md:pl-4 ml-1 md:ml-2 opacity-50 group-hover:opacity-100">
                            {item.tag}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>

    <div
        class="w-full overflow-hidden flex whitespace-nowrap mask-edges py-2 mt-1 md:mt-2"
    >
        <div
            class="flex items-center gap-4 md:gap-6 pr-4 md:pr-6 w-max animate-marquee-reverse"
            onmouseenter="this.style.animationPlayState='paused'"
            onmouseleave="this.style.animationPlayState='running'"
        >
            {
                row2.map((item) => (
                    <div
                        class="flex-shrink-0 flex items-center gap-2 md:gap-4 bg-[#1a1a1a] border-2 border-gray-900 px-4 md:px-6 py-2 md:py-3 transition-transform hover:-translate-y-1 cursor-default group"
                        style="box-shadow: 4px 4px 0 0 #FF4D8D;"
                    >
                        <Icon 
                            name={item.icon} 
                            class="w-5 h-5 md:w-8 md:h-8 grayscale group-hover:grayscale-0 transition-all" 
                        />
                        <span class="font-oswald text-lg md:text-2xl font-bold uppercase tracking-tight text-white">
                            {item.name}
                        </span>
                        <span class="font-mono text-[8px] md:text-[10px] text-gray-400 font-bold border-l-2 border-gray-700 pl-2 md:pl-4 ml-1 md:ml-2 group-hover:text-white transition-colors">
                            {item.tag}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>

    <div class="mt-8 md:mt-12 flex justify-center relative z-10">
        <div
            class="border-2 border-gray-400 px-3 md:px-4 py-1 rounded-full flex gap-3 md:gap-4 text-[10px] md:text-xs font-mono text-gray-500 bg-white/50 backdrop-blur-sm"
        >
            <span>WAIFU OF THE DAY: 09 ↗</span>
            <span>CODE: 9367 ↗</span>
        </div>
    </div>
</section>
