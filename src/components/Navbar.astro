<!-- NEO-BRUTALIST MOBILE OVERLAY DRAWER -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 bg-gray-950/70 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300 md:hidden flex items-start justify-end p-4 pt-16"
>
  <div
    id="mobile-menu-drawer"
    class="w-full max-w-xs sm:max-w-sm bg-white border-3 border-gray-950 rounded-3xl p-6 shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] space-y-6 relative translate-y-4 transition-transform duration-300 noise-overlay"
  >
    <!-- HEADER BAR -->
    <div class="flex items-center justify-between border-b-2 border-gray-950 pb-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-[#FF4D8D] border border-gray-950 inline-block shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]"></span>
        <span class="font-oswald text-xl font-bold tracking-tight text-gray-950">NAVIGATION</span>
      </div>
      <button
        id="mobile-menu-close"
        class="font-mono text-xs font-black uppercase bg-[#FF4D8D] text-white border-2 border-gray-950 px-2.5 py-1 rounded-md shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer"
      >
        ✕ CLOSE
      </button>
    </div>

    <!-- LINKS LIST -->
    <ul class="space-y-2.5 font-oswald text-xl sm:text-2xl font-bold uppercase tracking-tight">
      <li>
        <a href="#hero" class="mobile-nav-link block bg-[#F4F2EB] hover:bg-[#FACC15] text-gray-950 border-2 border-gray-950 px-4 py-2.5 rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-between">
          <span>HOME</span>
          <span class="font-mono text-xs text-gray-600">[01]</span>
        </a>
      </li>
      <li>
        <a href="#about" class="mobile-nav-link block bg-[#F4F2EB] hover:bg-[#FF4D8D] hover:text-white text-gray-950 border-2 border-gray-950 px-4 py-2.5 rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-between">
          <span>ABOUT</span>
          <span class="font-mono text-xs text-gray-600">[02]</span>
        </a>
      </li>
      <li>
        <a href="#projects" class="mobile-nav-link block bg-[#F4F2EB] hover:bg-[#0038FF] hover:text-white text-gray-950 border-2 border-gray-950 px-4 py-2.5 rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-between">
          <span>WORKS</span>
          <span class="font-mono text-xs text-gray-600">[03]</span>
        </a>
      </li>
      <li>
        <a href="#skills" class="mobile-nav-link block bg-[#F4F2EB] hover:bg-emerald-400 text-gray-950 border-2 border-gray-950 px-4 py-2.5 rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-between">
          <span>STACK</span>
          <span class="font-mono text-xs text-gray-600">[04]</span>
        </a>
      </li>
      <li>
        <a href="#lifelogs" class="mobile-nav-link block bg-[#F4F2EB] hover:bg-orange-400 text-gray-950 border-2 border-gray-950 px-4 py-2.5 rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-between">
