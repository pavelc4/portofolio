---
const logs = [
  {
    id: "01",
    category: "Daily / Study",
    title: "Informatics Student",
    desc: "Sering absen tapi tetep paham materi backend ops & sistem operasi.",
    tag: "STUDY",
    color: "bg-[#FF4D8D]",
    accent: "bg-[#FF4D8D]",
  },
  {
    id: "02",
    category: "Gaming / Roam",
    title: "Mobile Legends",
    desc: "Btw mayan jago maen Roamer, shotcall team & zone control.",
    tag: "GAMING",
    color: "bg-[#0038FF]",
    accent: "bg-[#0038FF]",
  },
  {
    id: "03",
    category: "Manga / Dark Fantasy",
    title: "Berserk",
    desc: "Dark fantasy masterpiece. Griffith tetep villain kelas kakap.",
    tag: "MANGA",
    color: "bg-[#22C55E]",
    accent: "bg-[#22C55E]",
  },
  {
    id: "04",
    category: "Music / Metal",
    title: "Engine No. 9 — Deftones",
    desc: "Heavy riff energetic track buat nemenin ngoding malam.",
    tag: "MUSIC",
    color: "bg-[#FF5500]",
    accent: "bg-[#FF5500]",
  },
];
---

<section
  id="lifelogs"
  class="py-16 md:py-24 bg-[#FAFAFA] border-t-2 border-gray-950 overflow-hidden relative grid-blueprint-bg"
>
  <div class="max-w-[98%] xl:max-w-[1500px] 2xl:max-w-[1700px] mx-auto px-2 sm:px-6 relative z-10">
    
    <!-- MAIN POSTER FRAME CONTAINER (MATCHING ALL OTHER SECTIONS) -->
    <div data-reveal class="neo-parallax-card relative w-full bg-white border-2 border-gray-950 shadow-[12px_12px_0px_0px_rgba(0,0,0,0.95)] p-5 sm:p-8 md:p-12 flex flex-col justify-between overflow-hidden noise-overlay">
      
      <!-- TOP HEADER GRID METADATA BAR -->
      <div class="w-full pb-4 sm:pb-6 border-b-2 border-gray-950 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 font-mono text-xs uppercase font-black text-gray-950">
        <div class="flex items-center gap-3">
          <span class="bg-gray-950 text-white px-2.5 py-1 border border-gray-950 font-mono text-xs font-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
            005 // PERSONAL LOGS
          </span>
        </div>

        <div class="text-left sm:text-right">
          <span class="bg-[#FACC15] text-gray-950 border border-gray-950 px-2.5 py-1 text-[9.5px] font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] rotate-1 inline-block">
            CASUAL & HOBBY INTERESTS
          </span>
        </div>
      </div>

      <!-- TITLE & GRID SECTION -->
      <div class="w-full my-6 sm:my-10 space-y-8">
        
        <!-- SECTION TITLE & SUBTITLE -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b-2 border-gray-950 pb-6">
          <div>
            <h2 class="neo-neon-glitch font-oswald text-5xl sm:text-7xl md:text-8xl font-bold uppercase tracking-tighter text-gray-950 leading-none inline-block">
              LIFE LOGS<span class="text-[#FF4D8D]">.</span>
            </h2>
          </div>

          <div class="font-mono text-xs text-gray-800 max-w-md">
            <p class="font-bold border-l-4 border-gray-900 pl-3 leading-relaxed">
              Behind the terminal: casual interests, gaming, music, manga & daily engineering student logs.
            </p>
          </div>
        </div>

        <!-- CARDS GRID (EXACT ROUNDED 3XL NEO-BRUTALIST CARDS) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
          {
            logs.map((log, idx) => (
              <div data-reveal style={`animation-delay:${idx * 80}ms`} class="bg-white border-2 border-gray-950 rounded-3xl p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:shadow-[14px_14px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all flex flex-col justify-between relative overflow-hidden group">
                
                <!-- HALFTONE DOT MATRIX ACCENT -->
                <div class="absolute right-4 top-4 w-16 h-16 halftone-dots opacity-20 pointer-events-none"></div>

                <!-- KANJUT CORNER FRAME TICKS -->
                <div class="corner-ticks"></div>

                <div>
                  <!-- TOP COLOR SWATCH & BADGE -->
                  <div class="flex items-center justify-between border-b-2 border-gray-900 pb-3 mb-5">
                    <span class={`font-mono text-[9.5px] font-black uppercase text-white ${log.color} px-3 py-1 rounded-full border border-gray-950 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]`}>
                      {log.tag}
                    </span>
                    <span class="font-mono text-xs font-black text-gray-900 tracking-wider">
                      §{log.id}/04
                    </span>
                  </div>

                  <p class="font-mono text-[9.5px] text-gray-500 font-bold uppercase tracking-wider mb-1">
                    {log.category}
                  </p>
                  <h3 class="font-oswald text-2xl sm:text-3xl font-bold text-gray-950 uppercase tracking-tight mb-3">
                    {log.title}
                  </h3>
                  <p class="font-mono text-xs sm:text-sm text-gray-800 leading-relaxed font-medium">
                    {log.desc}
                  </p>
                </div>

                <!-- FOOTER -->
                <div class="mt-6 pt-3 border-t-2 border-gray-950 flex justify-between items-center font-mono text-[9px] text-gray-600 font-bold uppercase">
                  <span class="bg-[#F4F2EB] px-2 py-0.5 border border-gray-300">LOGGED</span>
                  <span class="text-gray-950">pavelc4//logs</span>
                </div>
              </div>
            ))
          }
        </div>

      </div>

      <!-- BOTTOM METADATA BAR -->
      <div class="w-full pt-4 border-t-2 border-gray-950 flex flex-col sm:flex-row justify-between items-center gap-4 font-mono text-[10px] sm:text-xs font-black uppercase text-gray-950">
        <span class="bg-gray-950 text-white px-2.5 py-0.5 border border-gray-950">005 // PERSONAL LOGS</span>
        <span>BANDUNG, INDONESIA</span>
      </div>

    </div>

  </div>
</section>
