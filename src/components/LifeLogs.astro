  {
    id: '01',
    category: 'Daily',
    title: 'makan tidur kuliah maen game',
    desc: 'The cycle continues. Kadang nulis kode di tengah malam, kadang malah nonton anime.',
    tag: 'LIFESTYLE',
  },
  {
    id: '02',
    category: 'Gaming',
    title: 'FC25 & Mobile MOBA',
    desc: 'Stress relief setelah debug kernel 4 jam. Win rate lumayan, tapi tetap kalah sama deadline.',
    tag: 'GAMING',
  },
  {
    id: '03',
    category: 'Anime',
    title: 'JJK / Chainsaw Man / AOT',
    desc: 'Tontonan wajib. Gojo best character, fight me.',
    tag: 'ENTERTAINMENT',
  },
  {
    id: '04',
    category: 'Hardware',
    title: 'Motorcycle Modding',
    desc: 'Tuning motor sama kayak tuning kernel — sedikit tweak, beda banget hasilnya.',
    tag: 'IRL',
  },
  {
    id: '05',
    category: 'Open Source',
    title: 'Late Night Commits',
    desc: 'Majority of my commits timestamp: 00:00 — 03:00 WIB. Arch Linux + Hyprland never sleeps.',
    tag: 'DEV',
  },
  {
    id: '06',
