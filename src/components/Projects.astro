---
const projects = [
  {
    id: "01",
    name: "Auriya",
    phonetic: "(au-ri-ya)",
    slug: "auriya",
    badge: "Magisk / KernelSU",
    swatches: ["rust", "kernel", "perf", "core"],
    description:
      "An open-source Android performance optimization module built in Rust, designed for Magisk and KernelSU. Provides adaptive frame-aware scheduling, per-app refresh rate control, and system-level CPU and memory tuning to improve gaming and overall performance.",
    tags: ["RUST", "ANDROID OS", "PERFORMANCE"],
    github: "https://github.com/pavelc4/auriya",
    bgAccent: "bg-[#FF4D8D]",
    borderTop: "border-t-4 border-t-[#FF4D8D]",
    span: "lg:col-span-8",
    tilt: "-rotate-1",
  },
  {
    id: "02",
    name: "Rin",
    phonetic: "(rin-term-dev)",
    slug: "Rin",
    badge: "Apps / Terminal",
    swatches: ["kotlin", "pacman", "terminal"],
    description:
      "A modern Android terminal emulator built with Kotlin and Jetpack Compose, featuring a native pacman-style package manager written in Rust. Enables seamless terminal access and package management on Android 10+.",
    tags: ["KOTLIN", "ANDROID", "RUST"],
    github: "https://github.com/pavelc4/Rin",
    bgAccent: "bg-[#0038FF]",
    borderTop: "border-t-4 border-t-[#0038FF]",
    span: "lg:col-span-4",
    tilt: "rotate-1",
  },
  {
    id: "03",
    name: "Aether Bot",
    phonetic: "(ae-ther-stream)",
    slug: "aether",
    badge: "Telegram Bot",
    swatches: ["golang", "mtproto", "stream"],
    description:
      "A high-performance Telegram bot that streams media directly without intermediate storage. Built with a zero-disk streaming architecture in Golang, leveraging MTProto for fast uploads and concurrent chunk processing.",
    tags: ["GO", "MTProto", "STREAMING"],
    github: "https://github.com/pavelc4/aether-bot",
    bgAccent: "bg-[#22C55E]",
    borderTop: "border-t-4 border-t-[#22C55E]",
    span: "lg:col-span-5",
    tilt: "rotate-1",
  },
  {
    id: "04",
    name: "Xtra Kernel Manager",
    phonetic: "(xtra-ker-nel)",
    slug: "xtra-kernel-manager",
    badge: "Android App",
    swatches: ["kotlin", "governor", "tune"],
    description:
      "A modern Android app for monitoring and tuning kernel performance on rooted devices. Built with Kotlin and Jetpack Compose, it provides real-time CPU metrics, thermal insights, and dynamic governor control.",
    tags: ["KOTLIN", "ANDROID", "PERFORMANCE"],
    github: "https://github.com/Xtra-Manager-Software/Xtra-Kernel-Manager.git",
    bgAccent: "bg-[#FF5500]",
    borderTop: "border-t-4 border-t-[#FF5500]",
    span: "lg:col-span-7",
    tilt: "-rotate-1",
  },
];
---

<section
  id="projects"
  class="py-16 md:py-24 bg-[#FAFAFA] border-t-2 border-gray-950 overflow-hidden relative grid-blueprint-bg"
>
  <div class="max-w-[98%] xl:max-w-[1500px] 2xl:max-w-[1700px] mx-auto px-2 sm:px-6 relative z-10">
    
    <!-- MAIN POSTER FRAME CONTAINER -->
    <div class="relative w-full bg-white border-2 border-gray-950 shadow-[12px_12px_0px_0px_rgba(0,0,0,0.95)] p-5 sm:p-8 md:p-12 flex flex-col justify-between overflow-hidden noise-overlay select-none">
      
      <!-- TOP HEADER GRID METADATA BAR -->
      <div class="w-full pb-4 sm:pb-6 border-b-2 border-gray-950 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 font-mono text-xs uppercase font-black text-gray-950">
        <div class="flex items-center gap-3">
          <span class="bg-gray-950 text-white px-2.5 py-1 border border-gray-950 font-mono text-xs font-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
            004 // EXHIBITION CATALOG
          </span>
        </div>

        <div class="text-left sm:text-right">
          <span class="bg-[#FACC15] text-gray-950 border border-gray-950 px-2.5 py-1 text-[9.5px] font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] rotate-1 inline-block">
            FEATURED OPEN SOURCE WORK
          </span>
        </div>
      </div>

      <!-- SECTION TITLE & SUBTITLE -->
      <div class="w-full my-6 sm:my-10 space-y-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b-2 border-gray-950 pb-6">
          <div>
            <h2 class="font-oswald text-5xl sm:text-7xl md:text-8xl text-gray-950 font-bold uppercase tracking-tighter leading-none">
              PROJECTS<span class="text-[#FF4D8D]">.</span>
            </h2>
          </div>

          <div class="font-mono text-xs text-gray-800 max-w-md">
            <p class="font-bold border-l-4 border-gray-900 pl-3 leading-relaxed">
              Open-source software, high-performance services, low-level Rust tooling, dan aplikasi Android system-level.
            </p>
          </div>
        </div>

        <!-- ABSTRACT ASYMMETRIC BENTO COLLAGE GRID (8-4 & 5-7 SPANS) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
          {
            projects.map((proj, idx) => (
              <div class={`bg-white border-2 border-gray-950 ${proj.borderTop} rounded-3xl p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:shadow-[14px_14px_0px_0px_rgba(0,0,0,1)] ${proj.tilt} hover:rotate-0 transition-transform duration-300 flex flex-col justify-between relative overflow-visible group ${proj.span}`}>
                
                {/* ANIMATED PET GIF FOR RUST PROJECT: CRAB WALKING */}
                {idx === 0 && (
                  <img src="/portofolio/pets/crab_walk.gif" alt="Rust Crab Walking" class="w-8 h-8 absolute -top-5 left-8 z-30 hover:scale-125 transition-transform cursor-pointer" />
                )}

                <!-- HALFTONE DOT MATRIX ACCENT -->
                <div class="absolute right-4 top-4 w-20 h-20 halftone-dots opacity-20 pointer-events-none overflow-hidden rounded-3xl"></div>

                <div>
                  <!-- TOP COLOR SWATCH & BADGE -->
                  <div class="flex items-center justify-between border-b-2 border-gray-900 pb-3 mb-5">
                    <div class="flex items-center gap-2">
                      <div class="flex gap-1">
                        <span class="w-3 h-3 bg-gray-900 border border-gray-900 rounded-xs"></span>
                        <span class="w-3 h-3 bg-gray-400 border border-gray-900 rounded-xs"></span>
                        <span class={`w-3 h-3 ${proj.bgAccent} border border-gray-900 rounded-xs`}></span>
                      </div>
                      <div class="hidden sm:flex gap-1 font-mono text-[9px] font-bold text-gray-600 uppercase pl-2 border-l border-gray-300">
                        {proj.swatches.map((s) => (
                          <span class="mr-1">{s}</span>
                        ))}
                      </div>
                    </div>
                    <span class="font-mono text-xs font-black text-gray-900 tracking-wider">
                      §{proj.id}/04
                    </span>
                  </div>

                  <!-- PROJECT TITLE & PHONETIC BRACKET -->
                  <div class="mb-4">
                    <div class="flex items-baseline justify-between flex-wrap gap-2">
                      <h3 class="font-oswald text-4xl sm:text-5xl md:text-6xl font-bold uppercase tracking-tight text-gray-950 leading-none">
                        {proj.name}
                      </h3>
                      <span class="font-mono text-xs sm:text-sm text-gray-600 font-medium bg-[#F4F2EB] px-2 py-0.5 border border-gray-300 rounded-md">
                        {proj.phonetic}
                      </span>
                    </div>
                    <span class="inline-block mt-3 font-mono text-[10px] sm:text-xs font-bold uppercase px-3 py-1 bg-gray-950 text-white rounded-full border-1.5 border-gray-950 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                      {proj.badge}
                    </span>
                  </div>

                  <!-- DESCRIPTION -->
                  <p class="font-mono text-xs sm:text-sm text-gray-800 leading-relaxed mb-6 font-medium">
                    {proj.description}
                  </p>
                </div>

                <!-- FOOTER: PILL TAGS & ACTION BUTTON -->
                <div class="border-t-2 border-gray-900 pt-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div class="flex flex-wrap gap-1.5">
                    {proj.tags.map((t) => (
                      <span class="font-mono text-[9px] font-bold uppercase border-1.5 border-gray-950 rounded-full px-2.5 py-0.5 bg-[#F4F2EB] text-gray-950">
                        {t}
                      </span>
                    ))}
                  </div>

                  <a
                    href={proj.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`font-oswald text-xs sm:text-sm font-bold uppercase text-white ${proj.bgAccent} border-2 border-gray-950 px-5 py-2.5 rounded-full shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-gray-950 hover:text-white transition-all text-center flex items-center justify-center gap-2`}
                  >
                    <span>VIEW SOURCE</span>
                    <span class="font-mono text-xs font-bold">[->]</span>
                  </a>
                </div>

              </div>
            ))
          }
        </div>
      </div>

      <!-- BOTTOM METADATA BAR -->
      <div class="w-full pt-4 border-t-2 border-gray-950 flex flex-col sm:flex-row justify-between items-center gap-4 font-mono text-[10px] sm:text-xs font-black uppercase text-gray-950">
        <span class="bg-gray-950 text-white px-2.5 py-0.5 border border-gray-950">004 // EXHIBITION CATALOG</span>
        <span>BANDUNG, INDONESIA</span>
      </div>

    </div>

  </div>
</section>
