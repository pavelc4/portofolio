---
import { rawProjects } from "../data/projects";

// Fetch real-time GitHub stars during build/SSR concurrently
const projects = await Promise.all(
  rawProjects.map(async (p) => {
    try {
      const res = await fetch(`https://api.github.com/repos/${p.repoOwner}/${p.repoName}`, {
        headers: { "User-Agent": "Astro-Portfolio-Client" },
      });
      if (res.ok) {
        const data = await res.json();
        if (typeof data.stargazers_count === "number") {
          return { ...p, stars: data.stargazers_count };
        }
      }
    } catch (e) {
      // Fallback
    }
    return { ...p, stars: p.fallbackStars };
  })
);

const totalStars = projects.reduce((sum, p) => sum + (p.stars || 0), 0);
---

