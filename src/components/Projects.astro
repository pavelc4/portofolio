<script>
  import { initProjectsAnimation } from "../scripts/projects-anim";

  async function syncLiveGithubStars() {
    const starBadges = document.querySelectorAll<HTMLElement>('[data-repo-stars]');
    if (!starBadges.length) return;

    let currentTotal = 0;
    let successCount = 0;

    for (const badge of starBadges) {
      const repo = badge.dataset.repoStars;
      if (!repo) continue;
      try {
        const res = await fetch(`https://api.github.com/repos/${repo}`);
        if (res.ok) {
          const data = await res.json();
          if (typeof data.stargazers_count === 'number') {
            badge.textContent = `★ ${data.stargazers_count} STARS`;
            currentTotal += data.stargazers_count;
            successCount++;
          }
        }
      } catch (e) {
        // Fallback silently
      }
    }

    if (successCount > 0) {
      const totalEl = document.getElementById('total-stars-count');
      if (totalEl) {
        totalEl.textContent = `${currentTotal}`;
      }
    }
  }

  initProjectsAnimation();
  syncLiveGithubStars();

  document.addEventListener("astro:page-load", () => {
    initProjectsAnimation();
    syncLiveGithubStars();
  });
</script>
