---
---

<div class="relative bg-white border-2.5 border-gray-950 rounded-2xl shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] select-none overflow-hidden">
  
  <!-- RETRO WINDOW TITLE BAR (WIN95/WIN3.1 HYBRID IN NEO-BRUTALIST STYLE) -->
  <div class="bg-gray-950 text-white px-3 py-2 border-b-2 border-gray-950 flex items-center justify-between font-mono text-xs font-bold uppercase">
    <div class="flex items-center gap-2">
      <span class="text-white font-mono text-[11px] font-black tracking-wider">
        dino_runner.exe
      </span>
    </div>

    <!-- RETRO WINDOW CONTROL BUTTONS: [_] [□] [✕] -->
    <div class="flex items-center gap-1.5">
      <button aria-label="Minimize" class="w-5 h-5 bg-[#F4F2EB] text-gray-950 border border-gray-950 font-mono text-[10px] font-black flex items-center justify-center rounded shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:bg-gray-200 cursor-pointer">
        _
      </button>
      <button aria-label="Maximize" class="w-5 h-5 bg-[#F4F2EB] text-gray-950 border border-gray-950 font-mono text-[10px] font-black flex items-center justify-center rounded shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:bg-gray-200 cursor-pointer">
        □
      </button>
      <button aria-label="Close" class="w-5 h-5 bg-[#FF4D8D] text-white border border-gray-950 font-mono text-[10px] font-black flex items-center justify-center rounded shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:bg-red-600 cursor-pointer">
        ✕
      </button>
    </div>
  </div>

  <!-- INNER WINDOW BODY -->
  <div class="p-3 sm:p-4 bg-white">
    <!-- SUB-HEADER / TOOLBAR -->
    <div class="flex flex-wrap justify-between items-center border-b-2 border-gray-950 pb-2 mb-3 font-mono text-[10px] font-black uppercase gap-2">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></span>
        <span class="text-gray-950">DINO_RUNNER // AUTO_PILOT</span>
      </div>
      <span id="dino-theme-badge" class="bg-gray-950 text-white px-2 py-0.5 text-[8.5px] font-bold tracking-wider rounded border border-gray-950">
        DAY_MODE
      </span>
    </div>

    <!-- CANVAS CONTAINER WITH SHARP INNER BEZEL BORDER -->
    <div class="relative w-full h-40 sm:h-44 border-2 border-gray-950 rounded-xl overflow-hidden bg-[#F4F2EB] p-1 shadow-[inset_0_2px_4px_rgba(0,0,0,0.15)]" id="dino-canvas-wrapper">
      <div class="w-full h-full rounded-lg overflow-hidden relative bg-white border border-gray-950">
        <canvas id="dinoCanvas" class="w-full h-full block"></canvas>
      </div>
    </div>

    <!-- RETRO STATUS BAR FOOTER -->
    <div class="mt-3 flex flex-wrap justify-between items-center font-mono text-[9px] text-gray-900 font-bold uppercase border-t-2 border-gray-950 pt-2 gap-2">
      <span class="text-gray-700">SYS_STATUS: 200 OK</span>
      <span class="bg-[#0038FF] text-white px-2.5 py-0.5 font-black rounded border border-gray-950 shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)]">
        AUTO_PILOT // ACTIVE
      </span>
    </div>
  </div>
</div>

<script>
  import { initDinoRunner } from "../scripts/dino-runner";

  initDinoRunner();
</script>
