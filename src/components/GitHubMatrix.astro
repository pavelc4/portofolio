---
---

<div class="bg-white border-2 border-gray-900 p-4 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] select-none relative overflow-hidden">
  <!-- WIDGET HEADER (MATCHING DINO CARD HEADER) -->
  <div class="flex justify-between items-center border-b-2 border-gray-900 pb-2 mb-3 font-mono text-[10px] font-black uppercase">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></span>
      <span class="text-gray-950">GITHUB.MATRIX // SNAKE_EATER</span>
    </div>
    <span id="snake-status-badge" class="bg-gray-950 text-white px-2 py-0.5 text-[8.5px] font-bold tracking-wider">
      EATING_DOTS
    </span>
  </div>

  <!-- MATRIX CONTAINER (FULL-WIDTH PERFECT FIT GRID WRAPPER - NO SCROLLBAR) -->
  <div class="relative w-full border-2 border-gray-900 p-2.5 sm:p-4 bg-[#F4F2EB] overflow-hidden flex justify-center items-center transition-colors duration-700" id="matrix-wrapper">
    <div id="github-matrix-grid" class="inline-grid relative">
      <!-- JS dynamically populates tiles & animates Snake eating dots -->
    </div>
  </div>

  <!-- WIDGET FOOTER (MATCHING DINO CARD FOOTER) -->
  <div class="mt-3 flex justify-between items-center font-mono text-[9px] text-gray-900 font-bold uppercase border-t border-gray-300 pt-2">
    <div class="flex items-center gap-1 text-[8px]">
      <span class="text-gray-600">EATEN:</span>
      <span id="eaten-counter" class="text-emerald-700 font-black">000 DOTS</span>
    </div>
    <span class="bg-[#22C55E] text-gray-950 px-2 py-0.5 font-black border border-gray-900">
      GITHUB//CONTRIBUTIONS
    </span>
  </div>
</div>

<script>
  import { initGitHubSnakeEater } from "../scripts/snake-eater";

  initGitHubSnakeEater();
  document.addEventListener("astro:page-load", initGitHubSnakeEater);
</script>
