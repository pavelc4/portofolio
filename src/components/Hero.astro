---
import { Image } from "astro:assets";
import anuImg from "../assets/pets/anu.jpg";
---

<section
  id="hero"
  class="relative min-h-screen pt-20 md:pt-24 pb-8 md:pb-12 px-2 sm:px-6 lg:px-8 flex items-center justify-center overflow-hidden grid-blueprint-bg bg-[#FAFAFA]"
>
  <!-- Main Poster Frame with Neo-Brutalist Theme -->
  <div
    class="relative w-full max-w-[98%] xl:max-w-[1500px] 2xl:max-w-[1700px] bg-white border-2 border-gray-950 shadow-[12px_12px_0px_0px_rgba(0,0,0,0.95)] p-5 sm:p-8 md:p-12 flex flex-col justify-between overflow-hidden noise-overlay select-none"
  >
    <!-- TOP HEADER GRID METADATA BAR WITH 001 INDEX -->
    <div class="w-full pb-4 sm:pb-6 border-b-2 border-gray-950 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 font-mono text-xs uppercase font-black text-gray-950">
      <div class="flex items-center gap-3">
        <span class="bg-gray-950 text-white px-2.5 py-1 border border-gray-950 font-mono text-xs font-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          PAVELC4 // LANDING
        </span>
      </div>


      <div class="text-left sm:text-right">
        <span class="bg-[#FACC15] text-gray-950 border border-gray-950 px-2.5 py-1 text-[9.5px] font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] rotate-1 inline-block">
          BACKEND & LINUX DEV
        </span>
      </div>
    </div>

    <!-- CENTER MAIN CONTENT LAYOUT -->
    <div class="w-full my-4 sm:my-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center z-20">
      
      <!-- LEFT SIDE: RECTANGULAR KOTAK MEDIA CARD & KANJUT PRINTILAN WIDGETS -->
      <div class="lg:col-span-5 flex flex-col space-y-5">
        
        <!-- ABSTRACT TOP MICRO-ELEMENTS BAR WITH BORDER TICKS & SCOPE CROSSHAIR -->
        <div class="flex items-center justify-between font-mono text-[10px] font-bold text-gray-950 uppercase px-1">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"></span>
            <span class="tracking-wider">⊕ SYS.LOG // 0x7F</span>
          </div>

          <div class="flex items-center gap-2 font-mono text-[9px] text-gray-700">
            <span>[GO & TS]</span>
            <span class="text-gray-400">•</span>
            <span>[RUST SIDE]</span>
          </div>
        </div>

        <!-- RECTANGULAR KOTAK HERO MEDIA FRAME WITH KANJUT MINI QR CODE & HEX DUMP -->
        <div class="relative w-full h-[220px] sm:h-[260px] md:h-[270px] bg-gray-950 rounded-2xl p-2.5 border-3 border-gray-950 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] group">
          
          <!-- ANIMATED PET GIF: WALKING DOG -->
          <img src="/portofolio/pets/dog_walk.gif" alt="Dog Walking" class="w-8 h-8 absolute -top-5 left-6 z-40 hover:scale-125 transition-transform cursor-pointer" />

          <!-- HALFTONE ACCENT INSIDE MEDIA CARD -->
          <div class="absolute right-2 top-2 w-20 h-20 halftone-dots opacity-30 z-10 pointer-events-none"></div>

          <!-- KANJUT MINI QR CODE BADGE (TOP-RIGHT CORNER) -->
          <div class="absolute top-4 right-4 z-30 bg-white p-1 rounded border border-gray-950 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] flex flex-col items-center">
            <svg class="w-7 h-7 text-gray-950" viewBox="0 0 24 24" fill="currentColor">
              <path d="M2 2h8v8H2V2zm2 2v4h4V4H4zm8-2h10v10H12V2zm2 2v6h6V4h-6zM2 12h10v10H2V12zm2 2v6h6v-6H4zm14-2h4v2h-4v-2zm-6 4h4v2h-4v-2zm4 0h4v6h-4v-6zm-4 4h4v2h-4v-2z"/>
            </svg>
            <span class="font-mono text-[6.5px] font-black text-gray-950 mt-0.5">P4-QR</span>
          </div>

          <!-- KOTAK INNER IMAGE WRAPPER -->
          <div class="relative w-full h-full rounded-xl overflow-hidden bg-gray-900 flex items-center justify-center">
            <Image
              src={anuImg}
              alt="Dimas Dwi Ariyanto (pavelc4) Anime Artwork Banner"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none"></div>
          </div>

          <!-- FLOATING TOP-LEFT WIDGET CARD WITH CROSSHAIR SCOPE -->
          <div class="absolute -top-5 left-4 sm:left-6 bg-white border-2 border-gray-950 p-2.5 sm:p-3 rounded-xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] max-w-[180px] sm:max-w-[200px] -rotate-2 group-hover:rotate-0 transition-transform duration-300 z-30">
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-[8px] font-black uppercase bg-[#A7F3D0] text-gray-950 px-2 py-0.5 border border-gray-950 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                PRIMARY STACK
              </span>
              <span class="font-mono text-[9px] font-bold text-gray-950">⊕</span>
            </div>
            <div class="flex justify-between items-center mt-1">
              <span class="font-oswald text-[11px] font-bold uppercase text-gray-950">
                GO & TS (RUST SIDE)
              </span>
              <a href="#projects" class="bg-[#0038FF] text-white font-mono text-[8px] px-2 py-0.5 rounded-full font-bold border border-gray-950 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:bg-black transition-colors">
                VIEW [->]
              </a>
            </div>
          </div>

          <!-- FLOATING BOTTOM-RIGHT WIDGET CARD WITH HEX DUMP -->
          <div class="absolute -bottom-5 right-4 sm:right-6 bg-[#FACC15] text-gray-950 border-2 border-gray-950 p-2.5 sm:p-3 rounded-xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] max-w-[190px] sm:max-w-[220px] rotate-2 group-hover:rotate-0 transition-transform duration-300 z-30">
            <div class="flex items-center justify-between mb-1">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 bg-[#FF5500] border border-gray-950 rounded-full animate-ping"></span>
                <span class="font-mono text-[8px] font-black uppercase text-gray-950">
                  PAVELC4 / NOTE
                </span>
              </div>
              <span class="font-mono text-[7px] bg-black text-white px-1 py-0.2 rounded">0x7F</span>
            </div>
            <p class="font-mono text-[8.5px] text-gray-900 leading-tight font-bold">
              Mahasiswa Teknik Informatika Widyatama.
            </p>
          </div>

        </div>

        <!-- ACTION BUTTONS & COMMITS TAG -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <div class="flex items-center gap-3">
            <a
              href="#about"
              class="bg-white text-gray-950 border-2 border-gray-950 px-4 py-1.5 rounded-full font-oswald text-xs font-bold uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-gray-100 transition-all"
            >
              ABOUT ME
            </a>
            <a
              href="#projects"
              class="bg-[#FF5500] text-white border-2 border-gray-950 px-4 py-1.5 rounded-full font-oswald text-xs font-bold uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-gray-950 transition-all"
            >
              VIEW PROJECTS
            </a>
          </div>

          <div class="bg-[#A7F3D0] text-gray-950 px-3 py-1 rounded-full border-1.5 border-gray-950 font-mono text-[9px] font-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] flex items-center gap-1.5">
            <span class="w-2 h-2 bg-emerald-600 border border-gray-950 rounded-full"></span>
            <span>01 • 1,420 COMMITS</span>
          </div>
        </div>

      </div>


      <!-- RIGHT SIDE: ARTISTIC ABSTRACT STAGGERED TYPOGRAPHY -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-5 lg:pl-4 relative">
        
        <!-- HALFTONE DOT MATRIX PRINTILAN -->
        <div class="absolute right-0 top-0 w-28 h-28 halftone-dots opacity-25 pointer-events-none"></div>

        <div>
          <!-- TOP HUMBLE STICKER BADGE & JAPANESE TAG -->
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class="bg-[#FF4D8D] text-white font-mono text-[9px] font-black uppercase px-2.5 py-1 border border-gray-950 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] -rotate-2">
              DIMAS DWI ARIYANTO // STUDENT
            </span>
            <span class="bg-[#F4F2EB] text-gray-950 font-mono text-[8.5px] font-bold px-2 py-0.5 border border-gray-950 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
              学生 • BANDUNG
            </span>
            <span class="w-2.5 h-2.5 bg-[#FF5500] border border-gray-950 rounded-full inline-block"></span>
          </div>

          <!-- ARTISTIC ABSTRACT STAGGERED TYPOGRAPHY -->
          <div class="flex flex-col space-y-2 mb-4">
            <!-- LINE 1: LEARNING & (SHIFTED LEFT) -->
            <div class="flex items-center gap-3">
              <h1 class="font-oswald text-5xl sm:text-7xl md:text-8xl lg:text-[6.2rem] font-bold leading-[0.88] tracking-tighter text-gray-950 uppercase">
                LEARNING &
              </h1>
            </div>

            <!-- LINE 2: BUILDING (YELLOW BADGE - SHIFTED RIGHT) -->
            <div class="flex justify-start sm:pl-6">
              <span class="bg-[#FACC15] text-gray-950 font-oswald text-4xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-bold uppercase px-4 py-1 border-2 border-gray-950 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] -rotate-1 inline-block">
                BUILDING
              </span>
            </div>

            <!-- LINE 3: BACKEND SYSTEMS . (PINK BADGE - SHIFTED CENTER) -->
            <div class="flex items-center gap-3 pt-1 flex-wrap">
              <span class="bg-[#FF4D8D] text-white font-oswald text-4xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-bold uppercase px-4 py-1 border-2 border-gray-950 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] rotate-2 inline-block">
                BACKEND
              </span>
              <span class="font-oswald text-5xl sm:text-7xl md:text-8xl lg:text-[6rem] font-bold tracking-tighter text-gray-950 uppercase">
                SYSTEMS<span class="text-[#FF5500] animate-pulse">.</span>
              </span>
            </div>
          </div>

          <!-- PRINTILAN MICRO PILLS STRIP -->
          <div class="flex flex-wrap items-center justify-between gap-2 border-t border-b border-gray-300 py-2.5 mb-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-[9px] font-extrabold uppercase bg-[#F4F2EB] text-gray-950 px-2 py-0.5 border border-gray-950 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                LOC: BANDUNG, ID [6.9175° S]
              </span>
              <span class="font-mono text-[9px] font-extrabold uppercase bg-[#F4F2EB] text-gray-950 px-2 py-0.5 border border-gray-950 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                OS: ARCH LINUX
              </span>
              <span class="font-mono text-[9px] font-extrabold uppercase bg-[#A7F3D0] text-gray-950 px-2 py-0.5 border border-gray-950 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                ROLE: JUNIOR DEV
              </span>
            </div>

            <div class="flex items-center gap-2">
              <span class="font-mono text-[8px] font-black uppercase bg-black text-white px-2 py-0.5 border border-gray-950">
                0x7F
              </span>
              <div class="h-3.5 w-14 bg-gray-900 tech-barcode hidden sm:block"></div>
            </div>
          </div>
        </div>

        <!-- AUTHENTIC HUMBLE BIO PARAGRAPH -->
        <div class="pt-3 border-t-2 border-gray-950 relative">
          <p class="font-mono text-xs sm:text-sm text-gray-900 leading-relaxed font-medium max-w-xl">
            Halo! Saya Dimas Dwi Ariyanto (<strong class="bg-[#A7F3D0] border border-gray-950 px-1 font-bold">pavelc4</strong>), mahasiswa Teknik Informatika Universitas Widyatama, Bandung. Fokus utama saya di Golang & TypeScript, dengan eksplorasi Rust di waktu senggang serta pengulikan sistem Linux.
          </p>
        </div>

      </div>

    </div>


    <!-- BOTTOM METADATA BAR -->
    <div class="w-full pt-4 border-t-2 border-gray-950 flex flex-col sm:flex-row justify-between items-center gap-4 z-20 font-mono text-[10px] sm:text-xs font-black uppercase text-gray-950">
      <span class="bg-gray-950 text-white px-2.5 py-0.5 border border-gray-950">001 // PORTFOLIO</span>
      <span>BANDUNG, INDONESIA • [0x7F]</span>
    </div>

  </div>
</section>
