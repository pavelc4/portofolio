---
import { Image } from "astro:assets";
---

<section
  id="hero"
  class="relative min-h-screen pt-20 md:pt-24 pb-6 md:pb-10 px-4 md:px-6 lg:px-8 flex items-center justify-center overflow-hidden"
>
  <div
    class="relative w-full max-w-[95%] xl:max-w-[1600px] 2xl:max-w-[1800px] h-[80vh] min-h-[580px] sm:h-[70vh] sm:min-h-[480px] md:h-[90vh] md:min-h-[750px] flex flex-col border border-bocchi-pink shadow-2xl noise-overlay bg-bocchi-cream"
  >
    <div
      class="relative h-[75%] md:h-[70%] w-full bg-bocchi-pink overflow-hidden"
    >
      <div class="absolute inset-0 pointer-events-none opacity-[0.15]">
        <div class="absolute left-1/4 top-0 w-[1px] h-full bg-white"></div>
        <div
          class="absolute left-2/4 top-0 w-[1px] h-full bg-white border-dashed border-l"
        >
        </div>
        <div class="absolute left-3/4 top-0 w-[1px] h-full bg-white"></div>
        <div class="absolute top-1/3 left-0 w-full h-[1px] bg-white"></div>
        <div
          class="absolute top-2/3 left-0 w-full h-[1px] bg-white border-dashed border-t"
        >
        </div>
      </div>

      <div
        class="absolute left-4 sm:left-10 md:left-[5%] top-[5%] md:top-[8%] pointer-events-none select-none z-0 w-full overflow-hidden"
      >
        <h1
          class="text-transparent font-oswald text-[22vw] md:text-[18vw] lg:text-[16vw] leading-[0.85] tracking-tighter opacity-20"
          style="-webkit-text-stroke: 2px white;"
          aria-hidden="true"
        >
          Backend<br />Engineer
        </h1>
      </div>

      <div
        class="absolute top-3 left-4 text-white/50 font-mono text-sm leading-none"
        aria-hidden="true"
      >
        +
      </div>
      <div
        class="absolute top-3 right-4 text-white/50 font-mono text-sm leading-none"
        aria-hidden="true"
      >
        +
      </div>
      <div
        class="absolute bottom-4 left-4 text-white/50 font-mono text-sm leading-none"
        aria-hidden="true"
      >
        +
      </div>

      <div
        class="absolute top-14 right-4 md:top-12 md:right-12 w-20 h-20 sm:w-24 sm:h-24 md:w-36 md:h-36 lg:w-48 lg:h-48 border border-white/20 rounded-full flex items-center justify-center pointer-events-none z-10 opacity-70 md:opacity-100 animate-spin-slow"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 100 100"
          class="w-full h-full text-white/50 fill-current"
        >
          <path
            id="circlePath"
            d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0"
            fill="none"></path>
          <text
            class="text-[8.5px] md:text-[9.5px] font-mono font-bold tracking-widest uppercase"
            ><textPath href="#circlePath"
              >/// Hidup Jokowi /// My bini gw///</textPath
            ></text
          >
        </svg>
      </div>

      <div
        class="absolute top-0 left-0 bg-bocchi-cream text-bocchi-pink px-4 sm:px-6 md:px-8 py-2 md:py-3 rounded-br-2xl md:rounded-br-3xl font-oswald font-bold tracking-widest z-30 text-[9px] sm:text-xs md:text-sm border-r border-b border-bocchi-pink shadow-md"
      >
        DEV OF THE DAY <span class="text-red-600">#01</span>
      </div>

      <div
        class="hidden sm:flex absolute left-4 md:left-8 top-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-90 text-white/90 font-mono text-[10px] sm:text-xs md:text-sm lg:text-base tracking-[0.2em] md:tracking-[0.3em] font-bold mix-blend-overlay whitespace-nowrap z-10 select-none"
        aria-hidden="true"
      >
        Informatics Engineering Widyatama University
      </div>

      <div
        class="absolute top-[30%] right-[5%] md:right-[15%] text-white/10 font-oswald text-7xl md:text-9xl font-bold -rotate-90 origin-bottom-right z-0 pointer-events-none select-none"
        aria-hidden="true"
      >
        SYS.REQ
      </div>

      <div
        class="flex absolute bottom-28 sm:bottom-12 md:bottom-16 left-4 sm:left-6 md:left-14 flex-col gap-1 z-10 pointer-events-none opacity-80"
        aria-hidden="true"
      >
        <div
          class="flex h-8 sm:h-10 md:h-12 xl:h-16 w-32 sm:w-40 md:w-48 xl:w-64 bg-white tech-barcode mix-blend-overlay"
        >
        </div>
        <p
          class="font-mono text-[8px] sm:text-[9px] md:text-[10px] xl:text-xs text-white tracking-[0.2em] md:tracking-[0.3em] mt-1 font-bold mix-blend-overlay"
        >
          UID:1999-X-DEV // SYSTEM ACTIVE
        </p>
      </div>

      <div
        class="peer absolute bottom-0 right-[5%] md:right-[8%] lg:right-[10%] group z-30 cursor-pointer"
      >
        <div
          class="absolute -top-9 -right-4 sm:-top-10 sm:-right-6 md:-top-16 md:-right-12 text-white font-caveat text-5xl sm:text-6xl md:text-8xl lg:text-[7rem] opacity-90 z-30 -rotate-6 drop-shadow-md select-none whitespace-nowrap pointer-events-none"
        >
          pavelc4
        </div>
        <div
          class="w-[130px] h-[130px] sm:w-[180px] sm:h-[180px] md:w-[320px] md:h-[320px] lg:w-[450px] lg:h-[450px] xl:w-[500px] xl:h-[500px] bg-gray-900 border-t-[3px] border-x-[3px] md:border-t-[10px] md:border-x-[10px] border-bocchi-cream overflow-hidden shadow-2xl relative z-20 transform translate-y-[2px] transition-transform duration-500 group-hover:-translate-y-2 group-active:-translate-y-2"
        >
          <img
            src="https://github.com/pavelc4.png"
            alt="Pavelc4 Avatar"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover mix-blend-luminosity opacity-80 group-hover:mix-blend-normal group-hover:opacity-100 group-active:mix-blend-normal group-active:opacity-100 transition-all duration-500"
          />
        </div>
      </div>

      <div
        class="absolute left-4 sm:left-6 md:left-[10%] lg:left-[12%] top-[14%] sm:top-[20%] md:top-[20%] pointer-events-none select-none transition-all duration-500 z-40 peer-hover:z-10 peer-active:z-10"
      >
        <p
          class="text-white font-poppins text-lg sm:text-2xl md:text-4xl lg:text-5xl font-semibold mb-[-2px] md:mb-[-10px] lg:mb-[-15px] ml-1 md:ml-3 drop-shadow-md"
        >
          Just Ordinary student
        </p>
        <h1
          class="text-white font-oswald text-[18vw] md:text-[14vw] lg:text-[14vw] leading-[0.85] md:leading-[0.8] tracking-tighter mix-blend-overlay drop-shadow-lg"
        >
          Dimm<br />PAVELC4
        </h1>
      </div>
    </div>

    <div
      class="relative h-[25%] md:h-[30%] w-full bg-bocchi-cream border-t border-bocchi-pink p-4 sm:p-6 md:p-10 lg:p-12 flex items-end justify-between z-10 gap-2 md:gap-8"
    >
      <div
        class="absolute top-6 left-1/2 flex gap-1 pointer-events-none"
        aria-hidden="true"
      >
        <div class="w-2 h-2 md:w-3 md:h-3 bg-gray-400 rounded-full"></div>
        <div class="w-2 h-2 md:w-3 md:h-3 bg-gray-400 rounded-full"></div>
        <div
          class="w-2 h-2 md:w-3 md:h-3 border md:border-2 border-gray-500 rounded-full"
        >
        </div>
      </div>

      <div class="w-[65%] sm:w-[50%] lg:w-[45%] xl:w-[40%] pr-2 md:pr-4">
        <p
          class="text-[9px] sm:text-[10px] md:text-xs xl:text-sm text-gray-800 leading-tight md:leading-normal font-medium text-left"
        >
          <strong class="text-bocchi-pink font-bold inline-block mb-1"
            >Dimas Dwi Ariyanto (pavelc4)</strong
          >
          Informatics Engineering student at Widyatama University focused on backend
          engineering and performance-critical systems. Combines backend development
          with a deep understanding of Linux internals, enabling efficient, low-latency
          services. Enjoys optimizing systems, handling concurrency, and pushing performance
          to its limits.
        </p>
      </div>
      <div
        class="w-[35%] sm:w-[45%] text-right text-bocchi-pink flex flex-col items-end justify-end"
      >
        <p
          class="font-oswald text-xl sm:text-3xl md:text-5xl opacity-40 leading-none mb-1 md:mb-2"
          aria-hidden="true"
        >
          01 ↗
        </p>
        <p
          class="font-mono text-[5px] sm:text-[8px] md:text-xs xl:text-sm tracking-widest uppercase opacity-80 mb-2 sm:mb-3 md:mb-5 whitespace-nowrap"
        >
          SYSTEM CORE BUILDER
        </p>
        <h2
          class="font-oswald text-[6.5vw] sm:text-4xl md:text-[5vw] lg:text-[6vw] font-bold tracking-tighter uppercase text-gray-900 leading-none"
        >
          PORTFOLIO
        </h2>
      </div>
    </div>

    <div
      class="absolute top-[75%] md:top-[70%] left-0 w-full px-4 sm:px-6 md:px-12 lg:px-16 -translate-y-1/2 flex justify-between items-center z-40 pointer-events-none"
    >
      <div class="flex gap-2 md:gap-4 pointer-events-auto">
        <div
          class="bg-bocchi-cream text-gray-800 border border-bocchi-pink rounded-full px-3 sm:px-4 md:px-8 py-1 md:py-3 text-[8px] sm:text-[9px] md:text-base font-bold font-mono uppercase shadow-sm hover:bg-bocchi-pink hover:text-white transition-colors cursor-default"
        >
          BACKEND ENGINEER
        </div>
        <a
          href="#projects"
          class="bg-gray-900 text-white border border-gray-900 rounded-full px-3 sm:px-4 md:px-8 py-1 md:py-3 text-[8px] sm:text-[9px] md:text-base font-bold font-oswald uppercase shadow-sm hover:bg-gray-700 transition-colors hidden sm:block"
        >
          VIEW WORKS
        </a>
      </div>
      <a
        href="#about"
        class="bg-bocchi-cream text-bocchi-pink border border-bocchi-pink rounded-full w-10 h-10 sm:w-12 sm:h-12 md:w-20 md:h-20 lg:w-24 lg:h-24 flex items-center justify-center text-lg sm:text-xl md:text-3xl lg:text-4xl font-bold shadow-lg hover:scale-110 transition-transform pointer-events-auto"
        aria-label="Scroll to about section"
      >
        ↗
      </a>
    </div>
  </div>
</section>
