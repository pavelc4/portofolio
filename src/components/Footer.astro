---
const year = new Date().getFullYear();

const links = [
  { label: 'GitHub',   href: 'https://github.com/pavelc4' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/pavelc4' },
  { label: 'Email',    href: 'dimasdwiariyanto24' },
];
---

<footer class="bg-gray-900 text-white border-t-4 border-bocchi-pink py-12 md:py-16 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col md:flex-row justify-between md:items-end gap-6 md:gap-8">

      <div>
        <h2 class="font-oswald text-5xl md:text-6xl font-bold tracking-tighter text-white uppercase leading-none mb-2 md:mb-3">
          pavelc4.
        </h2>
        <p class="font-mono text-[10px] md:text-xs text-gray-400 uppercase tracking-widest leading-none">
          Dimas Dwi Ariyanto — Backend Engineer
        </p>
      </div>

      <nav aria-label="Social links" class="mb-[-2px] md:mb-[1px]">
        <ul class="flex flex-wrap gap-4 sm:gap-8" role="list">
          {links.map(link => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono uppercase tracking-widest text-xs text-gray-300 hover:text-bocchi-pink transition-colors flex items-center gap-1 group leading-none"
              >
                {link.label}
                <span class="font-oswald text-sm transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="font-mono text-[10px] text-gray-400 uppercase tracking-widest">
        © {year} pavelc4. Built with Astro + Svelte + Bun.
      </p>
      <p class="font-mono text-[10px] text-gray-400 uppercase tracking-widest">
        // SYSTEM CORE BUILDER //
      </p>
    </div>

  </div>
</footer>